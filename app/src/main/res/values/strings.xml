    <!-- Tutorial -->
    <string name="tutorial_step_counter">Step %1$d of %2$d</string>
    <string name="tutorial_prompt_tap_blocked">Tap the blue tile</string>
    <string name="tutorial_prompt_match">Match the blue tiles</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_start">Start</string>
    <string name="tutorial_lets_go">Let\'s go</string>
    <string name="tutorial_welcome_title">Welcome to Mahjong Solitaire</string>
    <string name="tutorial_welcome_message">Your goal is to clear the board by removing all tiles in matching pairs. This short tutorial shows you how it works.</string>
    <string name="tutorial_free_title">Selectable Tiles</string>
    <string name="tutorial_free_message">You can only pick a tile that is free: no other tile may lie on top of it, and its left or right side must be open. The blue tiles are free right now.</string>
    <string name="tutorial_blocked_title">Blocked Tiles</string>
    <string name="tutorial_blocked_message">The blue tile has neighbours on both its left and its right side, so it is blocked. Tap it and see what happens.</string>
    <string name="tutorial_pair_title">Match a Pair</string>
    <string name="tutorial_pair_message">Blocked tiles can\'t be selected. Now tap the two blue tiles. The first one turns gold to show it is selected. They are identical, so together they form a pair and are removed.</string>
    <string name="tutorial_seasons_title">Seasons</string>
    <string name="tutorial_seasons_message">Removing the pair opened up its neighbours. These are Season tiles (Spring, Summer, Autumn and Winter). Any two Seasons match each other, even though they look different. Match them!</string>
    <string name="tutorial_flowers_title">Flowers</string>
    <string name="tutorial_flowers_message">These two Flower tiles lie on top of other tiles, which stay blocked until the Flowers are gone. Any two Flowers (Plum, Orchid, Chrysanthemum and Bamboo) match each other, just like the Seasons.</string>
    <string name="tutorial_settings_title">Helpful Settings</string>
    <string name="tutorial_settings_message">Want a little help? You can turn these on right here, or change them any time in the Settings menu.</string>
    <string name="tutorial_your_turn_title">Your Turn</string>
    <string name="tutorial_your_turn_message">Clear the remaining tiles on your own. Stuck? The lightbulb shows a hint and the arrow undoes your last move.</string>

