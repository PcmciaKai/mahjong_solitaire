    <!-- Tile sets -->
    <string name="tile_set_bone_bamboo">Bone &amp; Bamboo</string>
    <string name="tile_set_bone_bamboo_description">Traditional pre-1950s set: a pored bone face dovetailed onto bamboo, with hand-painted engraving. Yellows and fades with age.</string>
    <string name="tile_set_catalin">Catalin</string>
    <string name="tile_set_catalin_description">Heavy, glassy resin from the 1920s to 1950s. Ages to a deep butterscotch that makes the paint stand out.</string>
    <string name="tile_set_celluloid">Celluloid</string>
    <string name="tile_set_celluloid_description">"French ivory" with fine grain lines on a bamboo back. Yellows unevenly and can crack.</string>
    <string name="tile_set_melamine">Melamine</string>
    <string name="tile_set_melamine_description">The standard modern set: bright white, glossy and vividly coloured. Barely changes with use.</string>
    <string name="tile_set_riichi">Riichi</string>
    <string name="tile_set_riichi_description">Japanese urea resin with a warm ivory face and crisp, vivid engraving. Warms slightly over the years.</string>
    <string name="tile_set_acrylic">Acrylic</string>
    <string name="tile_set_acrylic_description">Pure white face on a jewel-like, translucent back. Very glossy, but scratches turn it hazy.</string>
    <string name="tile_set_wood">Wood</string>
    <string name="tile_set_wood_description">Solid wood with visible grain and burned-in, muted symbols. Darkens and dents with use.</string>
    <string name="tile_set_jade">Jade</string>
    <string name="tile_set_jade_description">Polished stone with natural veining and gold-filled engraving. Elegant, with lower contrast.</string>
    <string name="tile_set_travel">Travel</string>
    <string name="tile_set_travel_description">Light plastic travel set with printed symbols. Yellows, scuffs, and the print rubs away.</string>

